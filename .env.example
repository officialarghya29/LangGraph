# =============================================================================
# Environment configuration template.
#
# Copy to `.env` and fill in real values:   cp .env.example .env
#
# `.env` is gitignored. NEVER commit real credentials.
#
# The defaults below are the local verification instance started by
# scripts/dev_services.sh, which listens on non-standard ports so it cannot
# collide with anything already on the machine.
# =============================================================================

# --- Application ------------------------------------------------------------ #
APP_NAME=langgraph-multi-agent
APP_ENV=development            # development | staging | production
DEBUG=false
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR | CRITICAL

# --- LLM provider (Phase 5) ------------------------------------------------- #
LLM_PROVIDER=openai            # openai | anthropic | local
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60

# --- Embedding provider (Phase 6) ------------------------------------------ #
EMBEDDING_PROVIDER=local       # cloud | local
EMBEDDING_MODEL=
EMBEDDING_API_KEY=

# --- PostgreSQL (Phase 3) --------------------------------------------------- #
DATABASE_URL=postgresql+asyncpg://langgraph:langgraph@127.0.0.1:55432/langgraph
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_ECHO=false

# --- Redis (Phase 4) -------------------------------------------------------- #
REDIS_URL=redis://127.0.0.1:56379/0

# --- Execution limits (Phase 2) -------------------------------------------- #
MAX_AGENT_ITERATIONS=10
MAX_TOOL_CALLS=25
MAX_EXECUTION_TIME=300
MAX_PARALLEL_TASKS=4
MAX_RETRIES=3
MAX_TOKEN_BUDGET=100000

# --- Security (Phases 25, 26, 30) ------------------------------------------ #
AUTH_ENABLED=true
JWT_SECRET=
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
FILESYSTEM_ALLOWED_ROOTS=./workspace
FILESYSTEM_MAX_FILE_BYTES=1048576

# --- Python execution sandbox (Phase 31) ----------------------------------- #
PYTHON_EXECUTION_ENABLED=false

# --- GitHub tool (Phase 33) ------------------------------------------------ #
GITHUB_TOKEN=
GITHUB_TOOL_ALLOW_WRITES=false

# --- Web search tool (Phase 29) -------------------------------------------- #
# Provider-agnostic: point SEARCH_API_URL at any endpoint that accepts
# {"query": ..., "count": ...} and returns {"results": [...]}.
SEARCH_API_URL=
SEARCH_API_KEY=

# --- Observability (Phase 27) ---------------------------------------------- #
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=langgraph-multi-agent
