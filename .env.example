# =============================================================================
# Environment configuration template.
#
# Copy to `.env` and fill in real values:   cp .env.example .env
#
# `.env` is gitignored. NEVER commit real credentials.
#
# Every setting the application reads is listed here, and this file is checked
# against the settings layer by tests/unit/test_env_example.py: a key that is not
# a setting, or a setting with no key, fails the suite. That matters because the
# settings layer ignores unknown keys, so a typo in this file would otherwise be
# accepted in silence and the value it meant to set would stay at its default.
#
# Values left blank mean "not configured" rather than "empty": a blank secret is
# treated as absent, and a blank name falls back to the default above it. For a
# few settings the distinction is the difference between a feature being off and
# being pointed at nothing, and the comments say which.
#
# The defaults below are the local verification instance started by
# scripts/dev_services.sh, which listens on non-standard ports so it cannot
# collide with anything already on the machine.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_NAME=langgraph-multi-agent
APP_ENV=development            # development | staging | production
DEBUG=false                    # must be false when APP_ENV=production
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR | CRITICAL

# --- Language model ----------------------------------------------------------
# The model name only means something to the vendor that serves it, so clearing
# LLM_MODEL selects that provider's own current default rather than a name
# borrowed from another vendor: gpt-5.6-terra for openai, claude-sonnet-5-5 for
# anthropic, llama3.1:8b for a local server. The name below is the openai one.
# Cheaper and larger siblings are drop-in: gpt-5.6-luna, gpt-5.6-sol.
LLM_PROVIDER=openai            # openai | anthropic | local
LLM_MODEL=gpt-5.6-terra
LLM_API_KEY=
LLM_BASE_URL=                  # only for a self-hosted, OpenAI-compatible endpoint
LLM_TIMEOUT_SECONDS=60
# Attempts per model call. This is a different budget from MAX_RETRIES, which
# bounds how often a run may be replanned after a failed verdict.
LLM_MAX_RETRIES=2
# Sampling temperature for calls that do not state one. The agents ask for a
# decision or an extraction, not prose, so zero is the default. Reasoning models
# reject the parameter outright and it is not sent to them.
LLM_TEMPERATURE=0.0
# Ceiling on model output, per call. Blank leaves the vendor's default, which is
# the right answer far more often than a number is: on a reasoning model the
# ceiling covers the model's own reasoning too, so a small value truncates the
# reply rather than shortening it.
LLM_MAX_OUTPUT_TOKENS=

# --- Embeddings --------------------------------------------------------------
# `local` is a deterministic hashing embedder that needs no credential and no
# network, which is what makes the memory tests reproducible. It takes no model:
# EMBEDDING_MODEL applies to `openai`, and clearing it selects
# text-embedding-3-small.
EMBEDDING_PROVIDER=local       # local | openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=256

# --- PostgreSQL --------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://langgraph:langgraph@127.0.0.1:55432/langgraph
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
# Logs every statement. Off by default: a logged statement can carry a prompt or
# a credential value.
DATABASE_ECHO=false

# --- Database tool -----------------------------------------------------------
# Where the agent-facing `database` tool is allowed to run SQL. Left blank, the
# tool is not registered at all: pointing it at DATABASE_URL would let an agent
# read every user, task, and memory row. Point it at a read-only replica.
DATABASE_TOOL_URL=
# Both default to false. Destructive statements additionally require a human
# approval. Turning either on also lifts the server-side read-only pin.
DATABASE_ALLOW_WRITES=false
DATABASE_ALLOW_DESTRUCTIVE=false
DATABASE_STATEMENT_TIMEOUT_MS=5000
DATABASE_MAX_ROWS=500

# --- Memory ------------------------------------------------------------------
MEMORY_ENABLED=true
# Minimum importance for a *durable* memory to be written. Volatile tiers are
# never thresholded.
MEMORY_IMPORTANCE_THRESHOLD=0.5
# How many candidates a retrieval may rank before returning. Exact scoring in
# Python is correct but linear, so the read is bounded explicitly.
MEMORY_SCAN_LIMIT=500
# Memories below this blended score are not injected into a prompt.
MEMORY_MIN_SCORE=0.15
MEMORY_VOLATILE_TTL_SECONDS=86400

# --- Checkpointing -----------------------------------------------------------
# `postgres` is durable: a run survives a restart and can be resumed by another
# worker. `memory` exists for tests, and a silent downgrade to it would remove
# the resume guarantee without anyone noticing.
CHECKPOINT_BACKEND=postgres    # postgres | memory
CHECKPOINT_POOL_SIZE=10
CHECKPOINT_OPEN_TIMEOUT_SECONDS=10

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:56379/0
# Namespace for every cache key, so one Redis can host several environments.
REDIS_KEY_PREFIX=langgraph
CACHE_DEFAULT_TTL_SECONDS=300

# --- Execution ceilings ------------------------------------------------------
# Every loop in the system is bounded by one of these, and each is enforced at a
# named point rather than trusted to the model: iterations and the wall clock at
# the dispatch loop, tool calls in the tool pipeline, parallelism at the dispatch
# semaphore, and retries in the retry policy.
MAX_AGENT_ITERATIONS=10
MAX_TOOL_CALLS=25
MAX_EXECUTION_TIME=300
MAX_PARALLEL_TASKS=4
MAX_RETRIES=3
MAX_TOKEN_BUDGET=100000

# --- Authentication and rate limiting ----------------------------------------
AUTH_ENABLED=true
# Required when APP_ENV=production. A blank value is treated as absent, so the
# production guard refuses to start rather than signing with nothing.
JWT_SECRET=
JWT_ALGORITHM=HS256            # HS256 | HS384 | HS512
JWT_AUDIENCE=
JWT_ISSUER=
# Development convenience: trust the caller's X-User-Id header when AUTH_ENABLED
# is false. Refused in production, because it lets any caller claim any identity.
TRUST_IDENTITY_HEADER=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
# Fail closed when the rate limiter cannot reach Redis. Off by default, since a
# cache outage taking the whole API down is usually the worse outcome.
RATE_LIMIT_FAIL_CLOSED=false

# --- API surface -------------------------------------------------------------
# Blank means "decide from the environment": served outside production, withheld
# inside it. Set it explicitly to override either way.
API_DOCS_ENABLED=
# The operator console. Off unless asked for: the page renders task text and
# carries approve, reject, and cancel buttons, so anyone who can reach it can
# drive the system. It authenticates exactly like any other client.
DASHBOARD_ENABLED=false

# --- Filesystem tool ---------------------------------------------------------
# Comma-separated. Paths are resolved to their real locations before use, so a
# symlink cannot escape a root.
FILESYSTEM_ALLOWED_ROOTS=./workspace
FILESYSTEM_MAX_FILE_BYTES=1048576

# --- Code execution ----------------------------------------------------------
# Off until there is a real isolation boundary. Enabling it without a sandbox
# raises at startup rather than pretending to be safe.
PYTHON_EXECUTION_ENABLED=false

# --- GitHub tool -------------------------------------------------------------
# Blank means the GitHub tools are not registered at all, so they are never
# advertised as available and then fail authentication on first use.
GITHUB_TOKEN=
GITHUB_TOOL_ALLOW_WRITES=false
GITHUB_API_URL=https://api.github.com

# --- Web search tool ---------------------------------------------------------
# Provider-agnostic: point SEARCH_API_URL at any endpoint that accepts
# {"query": ..., "count": ...} and returns {"results": [...]}.
SEARCH_API_URL=
SEARCH_API_KEY=
SEARCH_MAX_RESULTS=5
SEARCH_TIMEOUT_SECONDS=15

# --- Network egress ----------------------------------------------------------
# Outbound tools refuse private, loopback, and link-local destinations unless
# this is explicitly enabled. It exists for local development, not for
# deployments.
ALLOW_PRIVATE_NETWORK_EGRESS=false

# --- Observability -----------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=langgraph-multi-agent
# Serves GET /metrics in the Prometheus text format. Not authenticated by design:
# it exposes operation names, statuses, and timings, never a prompt or a
# credential. If it ever would, the fix is to stop recording that label.
METRICS_ENABLED=true
# Completed spans kept for introspection.
TRACE_HISTORY_SIZE=200
